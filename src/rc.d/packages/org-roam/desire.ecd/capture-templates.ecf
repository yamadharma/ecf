;;; -*- mode: emacs-lisp; lexical-binding: t; coding: utf-8-unix; -*-
;;; Capture template for org-roam

;;; Code:

;;;; do enable time-stamps
(setopt time-stamp-active t)

(setopt org-roam-capture-templates
	    '(("s" "per Section flow (two language)" plain
	       "#+created: %U
#+last_modified: %U
#+language: ru
#+date: %<%Y-%m-%dT%H:%M:%S%:z>
#+filetags:

:SETUP_LOCAL:
#+startup: overview num inlineimages latexpreview
#+options: ^:{} num:t
:END:
:SETUP_HUGO:
#+hugo_custom_front_matter: :slug ${slug}
:END:


* ${title}
:PROPERTIES:
:export_hugo_section: blog/%<%Y>
:export_hugo_bundle: %<%Y-%m-%d>--${slug}
:export_file_name: index.ru.md
:export_language: ru
:header-args: :dir (format \"%s\" org-roam-directory) :output-dir media/%<%Y>/%<%Y%m%dT%H%M%S> :async yes :cache yes
:END:

${title}

#+hugo: more
@@hugo:{{< toc >}}@@

%?

* ${title} [English] :noexport:
:PROPERTIES:
:export_hugo_section: blog/%<%Y>
:export_hugo_bundle: %<%Y-%m-%d>--${slug}
:export_file_name: index.en.md
:export_language: en
:header-args: :dir (format \"%s\" org-roam-directory) :output-dir media/%<%Y>/%<%Y%m%dT%H%M%S> :async yes :cache yes
:END:

${title} [English]

#+hugo: more
@@hugo:{{< toc >}}@@
"
	       :target
	       (file+head
	        "public/%<%Y%m%dT%H%M%S>--${slug}.org"
	        "#+title: ${title}")
	       :immediate-finish t
	       :jump-to-captured t
	       :unnarrowed t)
	      ))

;;;
