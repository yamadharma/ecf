;;; Deuteranopia themes
;;; For red-green color deficiency
;;; ef-deuteranopia-light
(modus-themes-load-theme 'ef-deuteranopia-light)
;;; ef-deuteranopia-dark
;; (load-theme 'ef-deuteranopia-dark :no-confirm)
;;; If you like two specific themes and want to switch between them
(setopt ef-themes-to-toggle '(ef-deuteranopia-light ef-deuteranopia-dark))

