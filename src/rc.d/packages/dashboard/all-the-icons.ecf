;;; Add icons to the widget headings and their items

;;; Use `all-the-icons' package
(setopt dashboard-icon-type 'all-the-icons)

;;; Add icons to the widget headings and their items
;; (setopt dashboard-set-heading-icons t)
(setopt dashboard-set-file-icons t)


;;; Show navigator below the banner
(setopt dashboard-set-navigator t)

