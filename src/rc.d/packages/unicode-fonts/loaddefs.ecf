;;; Code:

;;;; Requires font-utils
(desire 'font-utils)

;;;; Requires ucs-utils
(desire 'ucs-utils)

;;;; Uses if present
(desire 'persistent-soft)

;;;; Load package
(require 'unicode-fonts)

