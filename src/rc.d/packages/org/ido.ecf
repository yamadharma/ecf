;;;

;; Use IDO for both buffer and file completion and ido-everywhere to t
(setopt org-completion-use-ido t)
(setopt ido-everywhere t)
(setopt ido-max-directory-size 100000)
(ido-mode (quote both))

;; Use the current window when visiting files and buffers with ido
(setopt ido-default-file-method 'selected-window)
(setopt ido-default-buffer-method 'selected-window)
;; Use the current window for indirect buffer display
(setopt org-indirect-buffer-display 'current-window)

;;;