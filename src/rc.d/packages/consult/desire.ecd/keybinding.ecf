;;; -*- mode: emacs-lisp; lexical-binding: t; coding: utf-8-unix; -*-
;;; Consulting completing-read
;;; https://github.com/minad/consult

;; ;;; A recursive grep
;; (global-set-key (kbd "M-s M-g") #'("Recursive grep" . consult-grep))

;; ;;; Search for files names recursively
;; (global-set-key (kbd "M-s M-f") #'("Search for files names recursively" . consult-find))

;; ;;; Search through the outline (headings) of the file
;; (global-set-key (kbd "M-s M-o") #'("Search through the outline (headings) of the file" . consult-outline))

;; ;;; Search the current buffer
;; (global-set-key (kbd "M-s M-l") #'("Search the current buffer" . consult-line))

;; ;;; Switch to another buffer, or bookmarked file, or recently opened file
;; (global-set-key (kbd "M-s M-b") #'("Switch to another buffer" . consult-buffer))

(general-define-key
;;; C-c bindings in `mode-specific-map'
 "C-c M-x" 'consult-mode-command
 "C-c h" 'consult-history
 "C-c k" 'consult-kmacro
 "C-c m" 'consult-man
 "C-c i" 'consult-info
 [remap Info-search] 'consult-info
;;; C-x bindings in `ctl-x-map'
 "C-x M-:" 'consult-complex-command
 "C-x b" 'consult-buffer
 "C-x 4 b" 'consult-buffer-other-window
 "C-x 5 b" 'consult-buffer-other-frame
 "C-x t b" 'consult-buffer-other-tab
 "C-x r b" 'consult-bookmark
 "C-x p b" 'consult-project-buffer
;;; Custom M-# bindings for fast register access
 "M-#" 'consult-register-load
 "M-'" 'consult-register-store
 "C-M-#" 'consult-register
;;; Other custom bindings
 "M-y" 'consult-yank-pop
;;; M-g bindings in `goto-map'
 "M-g e" 'consult-compile-error
 "M-g f" 'consult-flymake
 "M-g g" 'consult-goto-line
 "M-g M-g" 'consult-goto-line
 "M-g o" 'consult-outline
 "M-g m" 'consult-mark
 "M-g k" 'consult-global-mark
 "M-g i" 'consult-imenu
 "M-g I" 'consult-imenu-multi
;;; M-s bindings in `search-map'
 "M-s d" 'consult-find
 "M-s c" 'consult-locate
 "M-s g" 'consult-grep
 "M-s G" 'consult-git-grep
 "M-s r" 'consult-ripgrep
 "M-s l" 'consult-line
 "M-s L" 'consult-line-multi
 "M-s k" 'consult-keep-lines
 "M-s u" 'consult-focus-lines)

;;; Isearch integration
(general-define-key
 "M-s e" 'consult-isearch-history)
(general-define-key
 :keymaps 'isearch-mode-map
 "M-e" 'consult-isearch-history
 "M-s e" 'consult-isearch-history
 "M-s l" 'consult-line
 "M-s L" 'consult-line-multi)

;;; Minibuffer history
(general-define-key
 :keymaps 'minibuffer-local-map
 "M-s" 'consult-history
 "M-r" 'consult-history)

;;;
