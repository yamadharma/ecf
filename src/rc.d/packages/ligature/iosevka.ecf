;;; -*- mode: emacs-lisp; lexical-binding: t; coding: utf-8-unix; -*-
;;; Set Iosevka font
;; https://be5invis.github.io/Iosevka/

;;; Code:

(ligature-set-ligatures
 '(prog-mode org-mode)
 '("<---" "<--"  "<<-" "<-" "->" "-->" "--->" "<->" "<-->" "<--->" "<---->" "<!--"
   "<==" "<===" "<=" "=>" "=>>" "==>" "===>" ">=" "<=>" "<==>" "<===>" "<====>" "<!---"
   "<~~" "<~" "~>" "~~>" "::" ":::" "==" "!=" "===" "!=="
   ":=" ":-" ":+" "<*" "<*>" "*>" "<|" "<|>" "|>" "+:" "-:" "=:" "<******>" "++" "+++"))

;;;
